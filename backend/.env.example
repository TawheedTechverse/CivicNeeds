# Copy this file to .env and fill in real values. Never commit .env.

# Postgres connection string. When running via docker-compose this is
# overridden automatically to point at the "postgres" service.
DATABASE_URL=postgresql+psycopg2://civicneeds:civicneeds@localhost:5432/civicneeds

# Get a free Gemini API key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Any long random string. Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# Optional overrides
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
GEMINI_MODEL=gemini-3-flash
CORS_ORIGINS=http://localhost:5173
